{
  "name": "frontend",
  "version": "1.0.0",
  "jsx": {
    "version": 4,
    "mode": "automatic"
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".bs.mjs",
  "bs-dependencies": [
    "@glennsl/rescript-fetch",
    "@rescript/core",
    "@rescript/react",
    "common",
    "rescript-relay",
    "rescript-relay-router"
  ],
  "bsc-flags": ["-open RescriptCore"],
  "warnings": {
    "error": "+A"
  },
  "ppx-flags": [],
  "namespace": true
}
